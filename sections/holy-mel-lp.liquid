{% comment %}
  HOLY MEL — Landing Page (seção completa, editável no personalizador)
  Requer os assets hm-*.webp / hm-*.png / hm-superpop*.otf|ttf enviados
  em Ativos (assets) do tema. Veja o LEIA-ME.txt do pacote.

  Estrutura:
    ticker · nav · hero (banner) · pills+CTA · problema+cards · você sabia ·
    certificações · avaliações · oferta+countdown · divisor · mel silvestre. só. ·
    FAQ · fechamento
{% endcomment %}

{%- liquid
  assign cta = section.settings.cta_url | default: '#comprar'

  if section.settings.img_logo != blank
    assign img_logo = section.settings.img_logo | image_url: width: 240
  else
    assign img_logo = 'hm-logo-brown.webp' | asset_url
  endif

  if section.settings.img_bottle != blank
    assign img_bottle = section.settings.img_bottle | image_url: width: 700
  else
    assign img_bottle = 'hm-photo-bottle.webp' | asset_url
  endif

  if section.settings.img_bear != blank
    assign img_bear = section.settings.img_bear | image_url: width: 520
  else
    assign img_bear = 'hm-bear-brown.webp' | asset_url
  endif

  if section.settings.img_face != blank
    assign img_face = section.settings.img_face | image_url: width: 420
  else
    assign img_face = 'hm-face-brown.webp' | asset_url
  endif

  if section.settings.img_girl != blank
    assign img_girl = section.settings.img_girl | image_url: width: 320
  else
    assign img_girl = 'hm-girl-running.webp' | asset_url
  endif

  if section.settings.img_offer_bg != blank
    assign img_offer_bg = section.settings.img_offer_bg | image_url: width: 1600
  else
    assign img_offer_bg = 'hm-honeycomb-photo.webp' | asset_url
  endif

  assign img_honeycomb_brown = 'hm-honeycomb-brown.png' | asset_url
  assign img_honeycomb_cream = 'hm-honeycomb-cream.png' | asset_url

  comment
    Logo: logo_visible corta a partir da direita quando < 100%.
  endcomment
  assign logo_h = 34
  assign logo_ratio = 1.758
  if section.settings.img_logo != blank and section.settings.img_logo.aspect_ratio > 0
    assign logo_ratio = section.settings.img_logo.aspect_ratio
  endif
  assign logo_pct = section.settings.logo_visible | default: 100
  assign logo_full_w = logo_ratio | times: logo_h
  assign logo_w = logo_full_w | times: logo_pct | divided_by: 100.0 | round: 1

  comment
    O painel 'Mel silvestre. Só.' tem fundo #642713; o urso marrom
    (hm-bear-brown) tem exatamente a mesma cor e desaparece nele.
    Padrao passa a ser a foto do pote, que contrasta.
  endcomment
  if section.settings.only_image != blank
    assign img_only = section.settings.only_image | image_url: width: 700
  else
    assign img_only = 'hm-photo-bottle.webp' | asset_url
  endif

  assign hex = 'polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%)'
  assign oct = 'polygon(50% 0%,90% 12%,100% 50%,90% 88%,50% 100%,10% 88%,0% 50%,10% 12%)'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
<style>
  @font-face { font-family:'Superpop'; src:url('{{ 'hm-superpop.otf' | asset_url }}') format('opentype'); font-weight:400; font-style:normal; font-display:swap; }
  @font-face { font-family:'Superpop'; src:url('{{ 'hm-superpop-light.ttf' | asset_url }}') format('truetype'); font-weight:300; font-style:normal; font-display:swap; }
  #holy-mel-lp, #holy-mel-lp * { box-sizing:border-box; }
  @keyframes hm-ticker { from{transform:translateX(0);} to{transform:translateX(-50%);} }
  @keyframes hm-float  { 0%,100%{transform:translateY(0) rotate(-1.5deg);} 50%{transform:translateY(-16px) rotate(1.5deg);} }
  @keyframes hm-float2 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-11px);} }
  @keyframes hm-bob    { 0%,100%{transform:translateY(0) rotate(0deg);} 50%{transform:translateY(-8px) rotate(3deg);} }
  @keyframes hm-spin   { from{transform:rotate(0deg);} to{transform:rotate(360deg);} }
  @keyframes hm-rise   { from{opacity:0;transform:translateY(46px);} to{opacity:1;transform:none;} }
  @keyframes hm-pop    { from{opacity:0;transform:scale(.85) translateY(28px);} to{opacity:1;transform:none;} }
  @keyframes hm-sl     { from{opacity:0;transform:translateX(-46px);} to{opacity:1;transform:none;} }
  #holy-mel-lp .hm-rise, #holy-mel-lp .hm-pop, #holy-mel-lp .hm-sl { opacity:1; }
  @supports (animation-timeline: view()) {
    #holy-mel-lp .hm-rise{animation:hm-rise both;animation-timeline:view();animation-range:entry 0% entry 55%;}
    #holy-mel-lp .hm-pop {animation:hm-pop  both;animation-timeline:view();animation-range:entry 5% entry 60%;}
    #holy-mel-lp .hm-sl  {animation:hm-sl   both;animation-timeline:view();animation-range:entry 0% entry 55%;}
  }
  #holy-mel-lp .hm-btn-lift:hover{transform:translateY(-1px);}
  #holy-mel-lp .hm-btn-cafe:hover{transform:translateY(-2px);}
  #holy-mel-lp .hm-btn-cafe:active{transform:translateY(3px);}
  #holy-mel-lp .hm-btn-outline:hover{background:#642713 !important;color:#FFF6E4 !important;}
  #holy-mel-lp .hm-btn-solid:hover{background:#4A1C0D !important;}
  @media (max-width:880px){
    #holy-mel-lp .hm-cards-3{grid-template-columns:repeat(2,1fr) !important;}
    #holy-mel-lp .hm-cert-cols{grid-template-columns:repeat(2,1fr) !important;}
    #holy-mel-lp .hm-only-cols{grid-template-columns:1fr !important;text-align:center;}
    #holy-mel-lp .hm-hero-h1{font-size:64px !important;}
  }
  @media (max-width:640px){
    #holy-mel-lp .hm-cards-3{grid-template-columns:1fr !important;}
    #holy-mel-lp .hm-fact-cols{grid-template-columns:1fr !important;}
    #holy-mel-lp .hm-nav-inner{padding:12px 18px !important;}
    #holy-mel-lp .hm-nav-cta{padding:13px 15px !important;font-size:11.5px !important;}
    #holy-mel-lp .hm-nav-logo{padding:5px 2px !important;}
    /* empilhado no telefone, o kit destacado vem primeiro */
    #holy-mel-lp .hm-kit--featured{order:-1;margin-top:18px;}
  }
  /* REVELAÇÃO CIRCULAR (pin + clip-path) — scroll-driven em CSS puro.
     Sem suporte a animation-timeline o bloco vira uma seção normal de 100vh
     com o vídeo já visível: degrada sem buraco de rolagem. */
  /* BARRA DE COMPRA FIXA — entra depois do banner e some quando a oferta
     esta na tela (nao faz sentido oferecer o que ja esta a vista). */
  #holy-mel-lp .hm-buybar{position:fixed;left:0;right:0;bottom:0;z-index:60;transform:translateY(115%);transition:transform .28s ease;}
  #holy-mel-lp .hm-buybar.hm-buybar--on{transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){ #holy-mel-lp .hm-buybar{transition:none;} }
  /* Hero banner (mesmo padrão da home / slideshow-hs) */
  #holy-mel-lp .hm-hero-banner{position:relative;}
  #holy-mel-lp .hm-hero-banner .hm-hero-slide-item img{width:100%;height:auto;display:block;}
  #holy-mel-lp .hm-hero-banner .swiper-pagination{bottom:14px !important;}
  #holy-mel-lp .hm-hero-banner.hm-hero-banner--single .swiper-pagination{display:none;}
  {%- if section.settings.footer_bg != blank -%}
  /* RODAPÉ — só nesta página. Duas travas: o seletor exige
     body.template-mel-da-holy, e este <style> só existe onde a seção
     Holy Mel LP está aplicada. Nenhuma outra página é alcançada.
     Original do tema: fundo #00B45A, .btn-loja-fisica #00814E,
     .btn-whatsapp #FFD88A com texto #00814E. */
  body.template-mel-da-holy footer{background:{{ section.settings.footer_bg }} !important;}
  body.template-mel-da-holy footer .btn-loja-fisica{background:#FFCD00 !important;border-color:#FFCD00 !important;color:#642713 !important;}
  body.template-mel-da-holy footer .btn-revendedor{border-color:#FFF6E4 !important;color:#FFF6E4 !important;}
  body.template-mel-da-holy footer .btn-whatsapp{color:#642713 !important;}
  {%- endif -%}
</style>

<div id="holy-mel-lp" style="font-family:'Nunito Sans',sans-serif;color:#642713;background:#FFF6E4;overflow-x:clip{% if section.settings.show_buybar %};padding-bottom:84px{% endif %}">

  {%- if section.settings.show_ticker -%}
  <!-- TICKER: o separador final é adicionado aqui pra emenda do loop ficar
       perfeita mesmo se o personalizador remover espaços das pontas -->
  {%- assign tick = section.settings.ticker_text | strip | append: '  ●  ' | replace: '  ', '&nbsp;&nbsp;' -%}
  <div style="background:#E29423;overflow:hidden;white-space:nowrap;position:relative;z-index:2">
    <div style="display:inline-block;padding:9px 0;animation:hm-ticker 34s linear infinite;will-change:transform">
      <span style="font-family:'Superpop',sans-serif;font-weight:400;font-size:12px;letter-spacing:.5px;text-transform:uppercase;color:#FFCD00">{{ tick }}{{ tick }}</span>
    </div>
  </div>
  {%- endif -%}

  <!-- NAV -->
  <header style="{% if section.settings.sticky_nav %}position:sticky;top:0;z-index:50;{% endif %}background:rgba(255,246,228,.94);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)">
    <div class="hm-nav-inner" style="position:relative;max-width:1160px;margin:0 auto;padding:16px 28px;display:flex;align-items:center;justify-content:flex-end;min-height:44px">
      <a href="#topo" class="hm-nav-logo" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;padding:5px 8px;text-decoration:none">
        <span style="display:block;{% if logo_pct < 100 %}width:{{ logo_w }}px;height:{{ logo_h }}px;overflow:hidden{% endif %}"><img src="{{ img_logo }}" alt="Holy Mel" style="height:{{ logo_h }}px;width:auto;max-width:none;display:block"></span>
      </a>
      {%- if section.settings.show_nav_cta -%}
      <a href="{{ cta }}" class="hm-btn-lift hm-nav-cta" style="position:relative;z-index:1;display:inline-flex;align-items:center;background:#FFCD00;color:#642713;font-family:'Superpop',sans-serif;font-weight:300;font-size:13px;letter-spacing:.3px;padding:11px 22px;border-radius:999px;text-decoration:none;box-shadow:0 3px 0 rgba(100,39,19,.18);transition:transform .12s;white-space:nowrap">{{ section.settings.nav_cta_light }}<span style="font-weight:600">&nbsp;{{ section.settings.nav_cta_bold }}</span></a>
      {%- endif -%}
    </div>
  </header>

  <!-- 1 · HERO
       Com blocos "Banner hero": full-bleed desk/mob (padrão home).
       Sem blocos com imagem desktop: mantém a colagem antiga (sem regressão visual). -->
  {%- liquid
    assign hm_hero_count = 0
    for block in section.blocks
      if block.type == 'hero_slide' and block.settings.image_slide != blank
        assign hm_hero_count = hm_hero_count | plus: 1
      endif
    endfor
  -%}
  {%- if hm_hero_count > 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'hero_slide' and block.settings.image_slide != blank -%}
  <link rel="preload" as="image" href="{{ block.settings.image_slide | image_url: width: 1900 }}">
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  <section id="topo" style="background:#FFF6E4;padding:clamp(14px,2vw,22px) 24px 0">
    <div style="max-width:1160px;margin:0 auto">
      <div class="hm-hero-banner hm-hero-swiper swiper{% if hm_hero_count == 1 %} hm-hero-banner--single{% endif %}" style="border-radius:36px;overflow:hidden;background:#FFCD00;box-shadow:0 18px 40px rgba(74,28,13,.16)">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
          {%- if block.type == 'hero_slide' and block.settings.image_slide != blank -%}
          <div class="swiper-slide hm-hero-slide-item" {{ block.shopify_attributes }}>
            {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" style="display:block">{%- endif -%}
            <picture>
              {%- if block.settings.image_slide_mb != blank -%}
              <source media="(max-width: 1024px)" srcset="{{ block.settings.image_slide_mb | image_url: width: 800 }}">
              {%- endif -%}
              {{ block.settings.image_slide | image_url: width: 1900 | image_tag: height: 'auto', alt: 'Holy Mel' }}
            </picture>
            {%- if block.settings.url != blank -%}</a>{%- endif -%}
          </div>
          {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </section>
  {%- else -%}
  <section id="topo" style="background:#FFF6E4;padding:clamp(14px,2vw,22px) 24px 0">
    <div style="max-width:1160px;margin:0 auto">
      <div style="background:#FFCD00;border-radius:36px;position:relative;overflow:hidden;min-height:clamp(300px,38vw,440px);display:flex;align-items:center;justify-content:center">
        <img src="{{ img_honeycomb_brown }}" alt="" aria-hidden="true" width="60" height="35" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.06;pointer-events:none">
        <img src="{{ img_bear }}" alt="" width="364" height="520" style="position:absolute;left:6%;bottom:0;height:clamp(150px,20vw,250px);width:auto;animation:hm-bob 4.5s ease-in-out infinite">
        <img src="{{ img_bottle }}" alt="Pote de mel Holy Mel em formato de urso" width="323" height="800" style="position:relative;z-index:2;height:clamp(240px,30vw,380px);width:auto;filter:drop-shadow(0 22px 26px rgba(100,39,19,.3));animation:hm-float 5.5s ease-in-out infinite">
        <img src="{{ img_face }}" alt="" width="388" height="320" style="position:absolute;right:7%;top:50%;transform:translateY(-50%);height:clamp(96px,12vw,150px);width:auto;animation:hm-bob 5s ease-in-out infinite">
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- 2 · PILLS + CTA -->
  {%- assign pill_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'pill' -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if pill_count > 0 or section.settings.show_hero_cta -%}
  <section style="background:#FFF6E4">
    {%- if pill_count > 0 -%}
    <div style="max-width:1160px;margin:0 auto;padding:clamp(20px,2.6vw,30px) 24px 0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px">
      {%- for block in section.blocks -%}
      {%- if block.type == 'pill' -%}
      <span {{ block.shopify_attributes }} style="display:inline-flex;align-items:center;gap:8px;border:1.5px solid rgba(100,39,19,.35);border-radius:999px;padding:10px 20px;font-family:'Superpop',sans-serif;font-weight:300;font-size:13.5px;letter-spacing:.3px;color:#642713;white-space:nowrap">{%- if block.settings.icon != blank -%}<span style="font-size:15px;line-height:1">{{ block.settings.icon }}</span>{%- endif -%}{{ block.settings.text }}</span>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if section.settings.show_hero_cta -%}
    <div style="max-width:1160px;margin:0 auto;padding:clamp(18px,2.2vw,26px) 24px 0;display:flex;flex-direction:column;align-items:center;gap:10px">
      <a href="{{ cta }}" class="hm-btn-cafe" style="display:inline-flex;align-items:center;justify-content:center;background:#FFCD00;color:#642713;font-family:'Superpop',sans-serif;font-weight:300;font-size:16px;padding:16px 36px;border-radius:999px;text-decoration:none;box-shadow:0 5px 0 rgba(100,39,19,.18);transition:transform .12s">{{ section.settings.hero_cta_light }}<span style="font-weight:600">&nbsp;{{ section.settings.hero_cta_bold }}</span></a>
      {%- if section.settings.hero_cta_note != blank -%}
      <div style="font-size:13px;font-weight:700;color:rgba(100,39,19,.62);text-align:center">{{ section.settings.hero_cta_note }}</div>
      {%- endif -%}
    </div>
    {%- endif -%}
  </section>
  {%- endif -%}

  <!-- 3 · PROBLEMA + CARDS -->
  <section id="problema" style="background:#FFF6E4">
    <div class="hm-rise" style="max-width:820px;margin:0 auto;padding:clamp(40px,5vw,64px) 24px 0;text-align:center">
      <h2 style="font-family:'Superpop',sans-serif;font-weight:600;font-size:clamp(28px,4.2vw,46px);line-height:1.1;letter-spacing:-.5px;text-transform:uppercase;color:#642713;margin:0 0 20px">{{ section.settings.problema_title }}</h2>
      <p style="font-family:'Nunito Sans';font-size:clamp(16px,1.6vw,18px);line-height:1.65;color:rgba(100,39,19,.78);max-width:640px;margin:0 auto">{{ section.settings.problema_text }}</p>
    </div>
    <div style="max-width:1040px;margin:0 auto;padding:clamp(36px,4.5vw,56px) 24px clamp(40px,5vw,70px)">
      <div class="hm-pop" style="background:#642713;border-radius:34px;padding:clamp(32px,4vw,48px) clamp(24px,3.5vw,44px);position:relative;overflow:hidden">
        <img src="{{ img_honeycomb_cream }}" alt="" aria-hidden="true" width="60" height="35" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.05;pointer-events:none">
        <div class="hm-cards-3" style="position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px">
          {%- for block in section.blocks -%}
          {%- if block.type == 'chip' -%}
          <div {{ block.shopify_attributes }} style="background:#FFCD00;border-radius:20px;padding:26px 20px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px">
            <span style="font-family:'Nunito Sans';font-weight:800;font-size:16px;color:#642713;line-height:1.3">{{ block.settings.title }}</span>
            <span style="font-family:'Nunito Sans';font-size:14px;line-height:1.55;color:rgba(100,39,19,.7)">{{ block.settings.sub }}</span>
          </div>
          {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div style="position:relative;display:flex;justify-content:center;margin-top:-30px">
        <div style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:180px;height:26px;background:radial-gradient(closest-side,rgba(100,39,19,.22),transparent);border-radius:50%"></div>
        <img src="{{ img_bottle }}" alt="Pote Holy Mel" width="323" height="800" style="position:relative;height:clamp(130px,17vw,210px);width:auto;z-index:3;filter:drop-shadow(0 16px 20px rgba(100,39,19,.22));animation:hm-float2 6.5s ease-in-out infinite">
      </div>
    </div>
  </section>

  <!-- 4 · VOCÊ SABIA -->
  {%- assign fact_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'fact' -%}{%- assign fact_count = fact_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if fact_count > 0 -%}
  <section style="background:#FFF6E4">
    <div class="hm-rise" style="max-width:1040px;margin:0 auto;padding:0 24px clamp(44px,5.5vw,72px)">
      <div style="text-align:center;margin-bottom:clamp(26px,3.5vw,38px)">
        {%- if section.settings.fact_kicker != blank -%}
        <div style="font-family:'Superpop';font-weight:300;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#E29423;margin-bottom:12px">{{ section.settings.fact_kicker }}</div>
        {%- endif -%}
        <h2 style="font-family:'Superpop',sans-serif;font-weight:400;font-size:clamp(30px,4.6vw,54px);line-height:1.02;letter-spacing:-.5px;color:#642713;margin:0">{{ section.settings.fact_title }}</h2>
      </div>
      <div class="hm-fact-cols" style="display:grid;grid-template-columns:repeat({{ fact_count | at_most: 2 }},minmax(0,1fr));gap:18px">
        {%- for block in section.blocks -%}
        {%- if block.type == 'fact' -%}
        <div class="hm-pop" {{ block.shopify_attributes }} style="background:#FFCD00;border-radius:24px;padding:30px 28px 32px;display:flex;flex-direction:column;gap:14px">
          {%- if block.settings.icon != blank -%}
          <span style="clip-path:{{ hex }};width:54px;height:47px;background:#642713;display:flex;align-items:center;justify-content:center;font-size:22px;line-height:1">{{ block.settings.icon }}</span>
          {%- endif -%}
          <h3 style="font-family:'Superpop',sans-serif;font-weight:400;font-size:clamp(19px,2.2vw,23px);color:#642713;margin:0">{{ block.settings.title }}</h3>
          <p style="font-family:'Nunito Sans';font-size:15px;line-height:1.6;color:rgba(100,39,19,.78);margin:0">{{ block.settings.text }}</p>
        </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- 5 · CERTIFICAÇÕES -->
  {%- assign cert_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'cert' -%}{%- assign cert_count = cert_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if cert_count > 0 -%}
  <section style="background:#FFF6E4;border-top:1px solid rgba(100,39,19,.18);border-bottom:1px solid rgba(100,39,19,.18)">
    <div class="hm-rise" style="max-width:1160px;margin:0 auto;padding:clamp(36px,4.5vw,56px) 24px">
      {%- if section.settings.cert_label != blank -%}
      <div style="text-align:center;margin-bottom:clamp(24px,3vw,34px)">
        <div style="font-family:'Nunito Sans';font-weight:800;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:rgba(100,39,19,.55)">{{ section.settings.cert_label }}</div>
      </div>
      {%- endif -%}
      <div class="hm-cert-cols" style="display:grid;grid-template-columns:repeat({{ cert_count | at_most: 4 }},minmax(0,1fr));gap:16px">
        {%- for block in section.blocks -%}
        {%- if block.type == 'cert' -%}
        <div {{ block.shopify_attributes }} style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px">
          <span style="clip-path:{{ hex }};width:68px;height:59px;background:#FFCD00;display:flex;align-items:center;justify-content:center;font-family:'Superpop';font-weight:600;font-size:17px;color:#642713;line-height:1">{{ block.settings.sigla }}</span>
