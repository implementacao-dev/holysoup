</div>

<script>
(function () {
  function initHolyMelFaq(root) {
    if (root.getAttribute('data-hm-faq-init')) return;
    root.setAttribute('data-hm-faq-init', '1');
    var items = root.querySelectorAll('.hm-faq-item');
    var openIdx = 0;
    function render() {
      items.forEach(function (item, i) {
        var open = i === openIdx;
        item.querySelector('.hm-faq-sign').textContent = open ? '–' : '+';
        var ans = item.querySelector('.hm-faq-ans');
        ans.style.maxHeight = open ? '340px' : '0';
        ans.style.opacity = open ? '1' : '0';
      });
    }
    items.forEach(function (item, i) {
      item.querySelector('.hm-faq-btn').addEventListener('click', function () {
        openIdx = (openIdx === i) ? -1 : i;
        render();
      });
    });
    render();
  }
  function initHolyMelHero(root) {
    var el = root.querySelector('.hm-hero-swiper');
    if (!el || el.swiper || typeof Swiper === 'undefined') return;
    var slides = el.querySelectorAll('.swiper-slide');
    if (!slides.length) return;
    new Swiper(el, {
      slidesPerView: 1,
      autoplay: slides.length > 1 ? { delay: 3000, disableOnInteraction: false } : false,
      pagination: {
        el: el.querySelector('.swiper-pagination'),
        clickable: true
      }
    });
  }
  /* Countdown honesto: precisa de uma data futura real.
     Data ausente, inválida ou já vencida => o bloco não aparece. */
  function initHolyMelCountdown(root) {
    var box = root.querySelector('.hm-countdown');
    if (!box || box.getAttribute('data-hm-cd-init')) return;
    var raw = (box.getAttribute('data-hm-end') || '').trim();
    if (!raw) return;
    var end = new Date(raw.replace(' ', 'T'));
    if (isNaN(end.getTime())) return;
    box.setAttribute('data-hm-cd-init', '1');
    var out = box.querySelector('.hm-timer');
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tick() {
      var diff = end.getTime() - Date.now();
      if (diff <= 0) { box.style.display = 'none'; clearInterval(timer); return; }
      var s = Math.floor(diff / 1000);
      var d = Math.floor(s / 86400);
      var h = Math.floor((s % 86400) / 3600);
      var m = Math.floor((s % 3600) / 60);
      var sec = s % 60;
      out.textContent = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(sec);
      box.style.display = 'flex';
    }
    tick();
    var timer = setInterval(tick, 1000);
  }
  /* Barra de compra: aparece depois que o banner sai da tela e recolhe
     enquanto a oferta esta visivel. Dois observers, nenhum listener de scroll. */
  function initHolyMelBuybar(root) {
    var bar = root.querySelector('.hm-buybar');
    if (!bar || bar.getAttribute('data-hm-bar-init')) return;
    var hero = root.querySelector('#topo');
    var oferta = root.querySelector('#comprar');
    if (!('IntersectionObserver' in window) || !hero || !oferta) {
      bar.classList.add('hm-buybar--on');
      return;
    }
    bar.setAttribute('data-hm-bar-init', '1');
    var passouHero = false, naOferta = false;
    function aplica() {
      bar.classList.toggle('hm-buybar--on', passouHero && !naOferta);
    }
    /* estado inicial por geometria: cobre o caso de a página abrir já
       rolada (link com âncora, F5 no meio) e serve de rede se o
       observer demorar a reportar */
    function sincroniza() {
      var vh = window.innerHeight;
      var hr = hero.getBoundingClientRect(), orf = oferta.getBoundingClientRect();
      passouHero = !(hr.bottom > 0 && hr.top < vh);
      naOferta = (orf.bottom > 0 && orf.top < vh);
      aplica();
    }
    /* depois do parse: durante ele o navegador ainda não pulou para a âncora
       e a medição sairia toda com scrollY = 0 */
    setTimeout(sincroniza, 0);
    window.addEventListener('load', sincroniza, { once: true });
    new IntersectionObserver(function (es) {
      passouHero = !es[0].isIntersecting;
      aplica();
    }, { threshold: 0 }).observe(hero);
    new IntersectionObserver(function (es) {
      naOferta = es[0].isIntersecting;
      aplica();
    }, { threshold: 0 }).observe(oferta);
  }
  function initHolyMel(root) {
    if (!root) return;
    initHolyMelFaq(root);
    initHolyMelHero(root);
    initHolyMelCountdown(root);
    initHolyMelBuybar(root);
  }
  var lp = document.getElementById('holy-mel-lp');
  if (lp) initHolyMel(lp);
  /* re-inicializa quando o personalizador da Shopify re-renderiza a seção */
  if (!window.__hmFaqListener) {
    window.__hmFaqListener = true;
    document.addEventListener('shopify:section:load', function (e) {
      var lp = e.target.querySelector('#holy-mel-lp') || (e.target.id === 'holy-mel-lp' ? e.target : null);
      if (lp) {
        lp.removeAttribute('data-hm-faq-init');
        initHolyMel(lp);
      }
    });
  }
})();
</script>

