    <div style="max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center">
      <a href="{{ cta }}" class="hm-btn-cafe" style="flex:1;max-width:520px;display:inline-flex;align-items:center;justify-content:center;background:#FFCD00;color:#642713;font-family:'Superpop',sans-serif;font-weight:600;font-size:16px;letter-spacing:.3px;padding:16px 28px;border-radius:999px;text-decoration:none;box-shadow:0 4px 0 rgba(100,39,19,.22);transition:transform .12s">{{ section.settings.buybar_text }}</a>
    </div>
  </div>
