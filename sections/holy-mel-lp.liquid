    <div class="hm-rise" style="max-width:1160px;margin:0 auto;padding:clamp(40px,5vw,64px) 24px clamp(48px,6vw,76px);display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center">
      {%- if section.settings.close_title != blank -%}
      <div style="font-family:'Superpop',sans-serif;font-weight:400;font-size:clamp(24px,3.4vw,38px);line-height:1.05;letter-spacing:-.5px;color:#642713">{{ section.settings.close_title }}</div>
      {%- endif -%}
      <a href="{{ cta }}" class="hm-btn-cafe" style="display:inline-flex;align-items:center;justify-content:center;background:#FFCD00;color:#642713;font-family:'Superpop',sans-serif;font-weight:300;font-size:16px;padding:16px 36px;border-radius:999px;text-decoration:none;box-shadow:0 5px 0 rgba(100,39,19,.18);transition:transform .12s">{{ section.settings.close_cta_light }}<span style="font-weight:600">&nbsp;{{ section.settings.close_cta_bold }}</span></a>
      {%- if section.settings.close_note != blank -%}
      <div style="font-family:'Nunito Sans';font-size:13px;font-weight:700;color:rgba(100,39,19,.62)">{{ section.settings.close_note }}</div>
