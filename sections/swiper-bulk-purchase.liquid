    assign bulk_modal_bg = section.settings.bulk_modal_bg
    if bulk_modal_bg == blank
      assign bulk_modal_bg = '#ffffff'
    endif
    assign bulk_savings_card_bg = section.settings.bulk_savings_card_bg
    if bulk_savings_card_bg == blank
      assign bulk_savings_card_bg = '#ffffff'
    endif
    assign bulk_footer_bg = section.settings.bulk_footer_bg
    if bulk_footer_bg == blank
      assign bulk_footer_bg = '#ffffff'
    endif
    assign bulk_category_color = section.settings.bulk_category_title_color
    if bulk_category_color == blank
      assign bulk_category_color = '#afaa7a'
    endif
    assign bulk_category_border = section.settings.bulk_category_title_border
    if bulk_category_border == blank
      assign bulk_category_border = '#afaa7a'
    endif
    assign bulk_footer_text = section.settings.bulk_footer_text_color
    if bulk_footer_text == blank
      assign bulk_footer_text = '#1a1a1a'
    endif
    assign bulk_hide_tier = section.settings.bulk_hide_current_tier
