      function updateCampaignProgress(q, faltam, total) {
        const cfg = getCampaignCfg();
        if (!cfg || !campaignMode || campaignMode === 'coupon') return;

        if (faltam <= 0 && campaignMode === 'offer2') {
          campaignMode = 'coupon';
          if (window.BulkCampaign) window.BulkCampaign.mark(window.BulkCampaign.KEY.couponUi);
          applyCampaignUI({ items: [] });
          return;
        }

        if (faltam <= 0) {
          setCampaignStage('complete');
        } else if (!campaignStage) {
          setCampaignStage('intercept');
        }

        const map = buildCampaignFillMap(q, faltam, total || campaignModalTotal);

        if (savingsHeader) {
          savingsHeader.classList.remove('is-campaign-progress', 'is-campaign-complete', 'is-campaign-intercept', 'is-campaign-offer2-progress', 'is-campaign-offer1-progress', 'is-campaign-offer1-complete-progress');
        }
        if (campaignNudgeEl) campaignNudgeEl.classList.remove('is-visible');
        if (campaignAlertEl) campaignAlertEl.classList.remove('is-visible');
        if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = true;
        if (campaignHeaderMsgEl) campaignHeaderMsgEl.hidden = true;
        if (campaignIncentiveEl) {
          campaignIncentiveEl.hidden = true;
          campaignIncentiveEl.classList.remove('bulk-campaign-incentive--outline');
        }
        if (campaignCompleteBannerEl) campaignCompleteBannerEl.hidden = true;

        const isOffer2Intercept = campaignStage === 'intercept' && campaignMode === 'offer2';
        const isOffer1Intercept = campaignStage === 'intercept' && campaignMode === 'offer1';
        const isOffer1Complete = campaignStage === 'complete' && campaignMode === 'offer1';
        const isFlatIntercept = isOffer1Intercept || isOffer2Intercept;
        const isOffer1FlatProgress = isOffer1Intercept || isOffer1Complete;

        if (!isFlatIntercept && !isOffer1Complete) {
          if (nextTierInfo) nextTierInfo.style.display = 'none';
          if (tierBadge) tierBadge.style.display = 'none';
          if (savingsContent) savingsContent.style.display = 'none';
          if (levelMaxMsg) levelMaxMsg.style.display = 'none';
        }

        if (progressFill && !isOffer1FlatProgress) {
          progressFill.style.width = Math.min((q / campaignTarget) * 100, 100) + '%';
          progressFill.style.backgroundImage = 'none';
          progressFill.style.backgroundColor = isOffer2Intercept ? '#005234' : (faltam > 0 ? '#ff5017' : '#7BCA0C');
        }
        if (progressBar && !isOffer1FlatProgress) progressBar.style.display = q > 0 ? 'block' : 'none';

        if (campaignStage === 'intercept') {
          if (isOffer2Intercept) {
            if (savingsHeader) savingsHeader.classList.add('is-campaign-offer2-progress');
            if (savingsContent) savingsContent.style.display = 'flex';
            if (savingsActiveMsg) savingsActiveMsg.style.display = 'flex';
            if (levelMaxMsg) levelMaxMsg.style.display = 'none';
            if (tierBadge) {
              tierBadge.style.display = 'flex';
              applyOffer2LockBadge(tierBadge);
            }
            if (nextTierInfo) {
              nextTierInfo.style.display = 'block';
              nextTierInfo.innerHTML = buildOffer2ProgressText(faltam, cfg);
            }
            if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = false;
            if (campaignHeaderMsgEl) {
              campaignHeaderMsgEl.innerHTML = buildOffer2InterceptTitle(campaignFill(cfg.interceptTitle, map));
              campaignHeaderMsgEl.hidden = false;
            }
            if (campaignIncentiveEl) {
              campaignIncentiveEl.innerHTML = buildOffer2IncentiveHtml(faltam, cfg);
              campaignIncentiveEl.classList.add('bulk-campaign-incentive--outline');
              campaignIncentiveEl.hidden = false;
            }
          } else if (isOffer1Intercept) {
            renderOffer1ProgressHeader({ variant: 'intercept', q: q, faltam: faltam, total: total });
            if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = false;
            if (campaignHeaderMsgEl) {
              campaignHeaderMsgEl.innerHTML = buildOffer2InterceptTitle(campaignFill(cfg.interceptTitle, map));
              campaignHeaderMsgEl.hidden = false;
            }
            if (campaignIncentiveEl) {
              campaignIncentiveEl.innerHTML = buildOffer1IncentiveHtml(faltam, map);
              campaignIncentiveEl.classList.add('bulk-campaign-incentive--outline');
              campaignIncentiveEl.hidden = false;
            }
          } else {
            if (savingsHeader) savingsHeader.classList.add('is-campaign-intercept', 'is-campaign-progress');
            if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = false;
            if (campaignHeaderMsgEl) {
              campaignHeaderMsgEl.innerHTML =
                '<strong class="bulk-campaign-header-msg__title">' + campaignFill(cfg.interceptTitle, map) + '</strong>';
              campaignHeaderMsgEl.hidden = false;
            }
            if (campaignIncentiveEl) {
              campaignIncentiveEl.textContent = campaignFill(cfg.interceptSubtitle, map);
              campaignIncentiveEl.classList.remove('bulk-campaign-incentive--outline');
              campaignIncentiveEl.hidden = false;
            }
          }
        } else if (campaignStage === 'complete') {
          if (isOffer1Complete) {
            renderOffer1ProgressHeader({ variant: 'complete', q: q, faltam: faltam, total: total });
            if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = false;
            if (campaignHeaderMsgEl) {
              campaignHeaderMsgEl.innerHTML = buildOffer1CompleteTitle(campaignFill(cfg.completeTemplate, map));
              campaignHeaderMsgEl.hidden = false;
            }
            if (campaignIncentiveEl) campaignIncentiveEl.hidden = true;
            if (campaignCompleteBannerEl && cfg.savingsBanner) {
              mountOffer1CompleteBanner();
              campaignCompleteBannerEl.innerHTML = buildOffer1SavingsBannerHtml(map);
              campaignCompleteBannerEl.classList.add('is-offer1-savings-box');
              campaignCompleteBannerEl.hidden = false;
            }
          } else {
            if (savingsHeader) savingsHeader.classList.add('is-campaign-complete');
            if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = false;
            if (campaignHeaderMsgEl) {
              campaignHeaderMsgEl.textContent = campaignFill(cfg.completeTemplate, map);
              campaignHeaderMsgEl.hidden = false;
            }
            if (campaignCompleteBannerEl && cfg.savingsBanner) {
              campaignCompleteBannerEl.textContent = campaignFill(cfg.savingsBanner, map);
              campaignCompleteBannerEl.hidden = false;
            }
          }
        }

        updateCampaignCta(faltam);
        applyCampaignGridLayout();
      }

      function restoreProductGrid() {
        document.querySelectorAll('.bulk-product-item').forEach(function (el) {
          const sid = el.dataset.originalSection;
          if (!sid) return;
          const section = document.getElementById(sid);
          const grid = section ? section.querySelector('.bulk-product-grid') : null;
          if (grid) grid.appendChild(el);
        });
        document.querySelectorAll('.bulk-collection-section').forEach(function (section) {
          section.style.display = '';
        });
      }

      function sortProductsByCartQty(cart) {
        if (!cart || !cart.items) return;
        const qtyMap = {};
        cart.items.forEach(i => { qtyMap[String(i.variant_id)] = i.quantity; });
        const isFlat = campaignStage === 'intercept' || campaignStage === 'complete' || campaignMode === 'coupon';
        document.querySelectorAll('.bulk-product-item').forEach(function (el) {
          const section = el.closest('.bulk-collection-section');
          if (section && !el.dataset.originalSection) {
            el.dataset.originalSection = section.id || '';
          }
        });
        if (isFlat) {
          const firstGrid = document.querySelector('.bulk-collection-section .bulk-product-grid');
          if (!firstGrid) return;
          const items = Array.from(document.querySelectorAll('.bulk-product-item'));
          items.sort((a, b) => (qtyMap[b.dataset.id] || 0) - (qtyMap[a.dataset.id] || 0));
          items.forEach(el => firstGrid.appendChild(el));
          document.querySelectorAll('.bulk-collection-section').forEach((section, idx) => {
            section.style.display = idx === 0 ? '' : 'none';
          });
          return;
        }
        restoreProductGrid();
        document.querySelectorAll('.bulk-collection-section').forEach(section => {
          const grid = section.querySelector('.bulk-product-grid');
          if (!grid) return;
          const items = Array.from(grid.querySelectorAll('.bulk-product-item'));
          items.sort((a, b) => (qtyMap[b.dataset.id] || 0) - (qtyMap[a.dataset.id] || 0));
          items.forEach(el => grid.appendChild(el));
        });
      }

      function applyCampaignUI(cart) {
        const cfg = getCampaignCfg();
        if (!cfg || !campaignMode || campaignMode === 'normal') return;

        if (campaignMode === 'coupon') {
          const q = window.BulkCampaign ? window.BulkCampaign.eligibleQty(cart) : campaignEligibleQty;
          campaignEligibleQty = q || campaignEligibleQty;
          setCampaignStage('complete');

          if (savingsHeader) {
            savingsHeader.classList.remove(
              'is-campaign-progress',
              'is-campaign-intercept',
              'is-campaign-complete',
              'is-campaign-offer2-progress',
              'is-campaign-offer1-progress',
              'is-campaign-offer1-complete-progress'
            );
          }
          if (campaignCompleteBannerEl) {
            restoreCompleteBannerHome();
          }

          const progressRoot = document.getElementById('bulk-progress-root');
          if (progressRoot) progressRoot.style.display = 'none';
          if (progressBar) progressBar.style.display = 'none';
          if (tierBadge) tierBadge.style.display = 'none';
          if (savingsContent) savingsContent.style.display = 'none';
          if (nextTierInfo) nextTierInfo.style.display = 'none';

          const modalBodyEl = document.querySelector('.bulk-modal-body');
          if (modalBodyEl) modalBodyEl.style.display = '';
          const summaryEl = document.querySelector('.bulk-summary');
          if (summaryEl) summaryEl.style.display = '';
          const giftsFooter = document.querySelector('.gift-progress-badges-modal');
          if (giftsFooter) giftsFooter.style.display = '';
          const btn = document.querySelector('.bulk-buy-btn');
          if (btn) btn.style.display = '';

          if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = false;
          if (campaignIncentiveEl) {
            campaignIncentiveEl.hidden = true;
            campaignIncentiveEl.classList.remove('bulk-campaign-incentive--outline');
          }

          if (campaignHeaderMsgEl) {
            campaignHeaderMsgEl.innerHTML = buildCouponTitleHtml(
              campaignFill(cfg.couponBanner || 'LIBEROU +{{pct_cupom}}%OFF COM CUPOM', {
                pct_cupom: cfg.coupon.pct
              })
            );
            campaignHeaderMsgEl.hidden = false;
          }

          if (campaignCouponEl) {
            const codeEl = campaignCouponEl.querySelector('[data-coupon-code]');
            const copyEl = campaignCouponEl.querySelector('[data-bulk-campaign-copy]');
            if (codeEl) codeEl.textContent = cfg.coupon.code || '';
            if (copyEl) copyEl.textContent = cfg.coupon.copy || 'COPIAR CUPOM';
            campaignCouponEl.hidden = false;
            campaignCouponEl.classList.add('is-visible');
          }

          if (campaignCouponSavingsEl) {
            let itemsCount = 0;
            let total = campaignModalTotal || 0;
            if (!total && productsCache.length) {
              productsCache.forEach(function (item) {
                const qty = parseInt(item.input ? item.input.value : 0, 10) || 0;
                if (qty > 0 && item.price > 0) {
                  itemsCount += qty;
                  total += item.price * qty;
                }
              });
            } else {
              productsCache.forEach(function (item) {
                const qty = parseInt(item.input ? item.input.value : 0, 10) || 0;
                if (qty > 0 && item.price > 0) itemsCount += qty;
              });
            }
            const qtyForGifts = Math.max(campaignEligibleQty || 0, itemsCount);
            let currentTier = null;
            tiers.forEach(function (t) { if (qtyForGifts >= t.qty) currentTier = t; });
            const discountPct = currentTier ? currentTier.discount : 0;
            const discountedTotal = total * (1 - discountPct / 100);
            const couponPct = Number(cfg.coupon.pct || 10);
            const couponSavings = discountedTotal * (couponPct / 100);
            const economiaText = formatCampaignMoney
              ? formatCampaignMoney(couponSavings)
              : (Shopify.formatMoney(couponSavings, window.money_format) || '');
            campaignCouponSavingsEl.innerHTML = buildCouponSavingsHtml(
              economiaText,
              countUnlockedGifts(qtyForGifts)
            );
            campaignCouponSavingsEl.hidden = false;
          }

          updateCampaignCta(0);
          applyCampaignGridLayout();
          if (cart && cart.items) sortProductsByCartQty(cart);
          return;
        }

        const q = window.BulkCampaign ? window.BulkCampaign.eligibleQty(cart) : campaignEligibleQty;
        campaignEligibleQty = q;
        const faltam = Math.max(0, campaignTarget - q);

        if (faltam > 0) {
          setCampaignStage('intercept');
        } else {
          setCampaignStage('complete');
        }

        updateCampaignProgress(q, faltam, campaignModalTotal);
      }

      async function openCampaign(mode, cart) {
        const cfg = getCampaignCfg();
        if (!cfg) return;
        campaignMode = mode;
        if (mode === 'offer1') {
          campaignTarget = cfg.offer1.target || 15;
          if (window.BulkCampaign) window.BulkCampaign.mark(window.BulkCampaign.KEY.o1Seen);
        } else if (mode === 'offer2') {
          campaignTarget = cfg.offer2.target || 25;
          if (window.BulkCampaign) window.BulkCampaign.mark(window.BulkCampaign.KEY.o2Seen);
        } else if (mode === 'coupon') {
          if (window.BulkCampaign) window.BulkCampaign.mark(window.BulkCampaign.KEY.couponUi);
        }
        if (container) container.classList.add('is-campaign-mode');
        const btn = document.querySelector('.bulk-buy-btn');
        if (btn) btn.style.display = '';
        snapshotCampaignBaseline(cart || { items: [] });
        await openModal(null, true);
        if (cart) {
          campaignEligibleQty = window.BulkCampaign ? window.BulkCampaign.eligibleQty(cart) : 0;
          sortProductsByCartQty(cart);
        }
        applyCampaignUI(cart || { items: [] });
        updateTotals();
      }

      function updateProductsCache() {
        const items = document.querySelectorAll('.bulk-product-item');
        productsCache = Array.from(items).map(item => ({
          el: item,
          id: item.dataset.id,
          price: parseInt(item.dataset.price) || 0,
          input: item.querySelector('.bulk-qty-input'),
          priceEl: item.querySelector('.bulk-product-price'),
          img: item.querySelector('.bulk-product-image img'),
          minus: item.querySelector('.minus'),
          plus: item.querySelector('.plus')
        }));
      }

      async function syncWithCart() {
        try {
          const res = await fetch(window.Shopify.routes.root + 'cart.js');
          const cart = await res.json();
          if (productsCache.length === 0) updateProductsCache();
          productsCache.forEach(item => {
            const cartItem = cart.items.find(i => i.variant_id == item.id);
            const qty = cartItem ? cartItem.quantity : 0;
            if (item.input) item.input.value = qty;
            updateQtyHighlight(item, qty);
          });
          if (window.BulkCampaign) {
            lastCartEligibleQty = window.BulkCampaign.eligibleQty(cart);
            campaignEligibleQty = lastCartEligibleQty;
          }
          updateTotals();
          if (campaignMode && campaignMode !== 'coupon') {
            const faltam = Math.max(0, campaignTarget - campaignEligibleQty);
            updateCampaignProgress(campaignEligibleQty, faltam, campaignModalTotal);
          }
        } catch (e) {
          console.error('Error syncing with cart:', e);
          updateTotals();
        }
      }

      async function openModal(index, keepCampaign) {
        if (!keepCampaign) resetCampaignUI();
        if (modalBody) {
          modalBody.style.scrollBehavior = 'auto';
          modalBody.scrollTop = 0;
        }
        overlay.classList.add('active');
        container.classList.add('active');
        body.style.overflow = 'hidden';
        window.isInitialSync = true;
        updateProductsCache();
        await syncWithCart();
        window.isInitialSync = false;
        if (index) {
          setTimeout(() => {
            const target = document.getElementById(`bulk-cat-${index}`);
            if (target && modalBody) {
              const scrollTopTarget = (index === '1') ? 0 : target.offsetTop;
              modalBody.scrollTo({ top: scrollTopTarget, behavior: 'smooth' });
            }
          }, 500);
        }
      }

      function closeModal() {
        if (campaignMode === 'offer2' && window.BulkCampaign) {
          window.BulkCampaign.mark(window.BulkCampaign.KEY.o2X);
        }
        if (campaignMode === 'offer1' || campaignMode === 'offer2' || campaignMode === 'coupon') {
          resetCampaignUI();
        }
        if (cartSyncController) cartSyncController.abort();
        overlay.classList.remove('active');
        container.classList.remove('active');
        body.style.overflow = '';
      }

