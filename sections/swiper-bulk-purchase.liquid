{% schema %}
{
  "name": "Popup Progressivo",
  "settings": [
    {
      "type": "richtext",
      "id": "rich_title",
      "label": "Título Principal (Rich Text)",
      "default": "<p>QUANTO VOCÊ QUER <strong>ECONOMIZAR HOJE</strong></p>"
    },
    {
      "type": "header",
      "content": "Categorias (Coleções)"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Coleção 1"
    },
    {
      "type": "collection",
