<script>
  (function() {
    window.money_format = {{ shop.money_format | json }};
    
    if (typeof Shopify === 'undefined') window.Shopify = {};
    if (!Shopify.formatMoney) {
      Shopify.formatMoney = function(cents, format) {
        if (typeof cents === 'string') cents = cents.replace('.', '');
        let value = '';
        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        const formatString = format || window.money_format;

        function formatWithDelimiters(number, precision, thousands, decimal) {
          precision = precision || 2;
          thousands = thousands || ',';
          decimal = decimal || '.';
          if (isNaN(number) || number == null) return 0;
          number = (number / 100.0).toFixed(precision);
          const parts = number.split('.'),
            dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
            cents = parts[1] ? decimal + parts[1] : '';
          return dollars + cents;
        }

        switch (formatString.match(placeholderRegex)[1]) {
          case 'amount': value = formatWithDelimiters(cents, 2); break;
          case 'amount_no_decimals': value = formatWithDelimiters(cents, 0); break;
          case 'amount_with_comma_separator': value = formatWithDelimiters(cents, 2, '.', ','); break;
          case 'amount_no_decimals_with_comma_separator': value = formatWithDelimiters(cents, 0, '.', ','); break;
        }
        return formatString.replace(placeholderRegex, value);
      };
    }

    function init() {
      if (typeof Swiper === 'undefined') {
        setTimeout(init, 100);
        return;
      }

      const swiperBulk = new Swiper('.swiper-bulk', {
        slidesPerView: 1.1,
        spaceBetween: 10,
        freeMode: true,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        breakpoints: {
          500: { slidesPerView: 2.2, spaceBetween: 15 },
          967: { slidesPerView: 3.2, spaceBetween: 20 },
          1200: { slidesPerView: 4, spaceBetween: 25 }
        }
      });

      const body = document.body;
      const overlay = document.querySelector('.bulk-modal-overlay');
      const container = document.querySelector('.bulk-modal-container');
      const closeBtn = document.querySelector('.bulk-modal-close');
      const slides = document.querySelectorAll('.swiper-bulk-purchase .swiper-slide');
      const modalBody = document.querySelector('.bulk-modal-body');

      const tiers = [
        { 
          qty: {{ section.settings.tier_1_qty | default: 4 }}, 
          discount: {{ section.settings.tier_1_pct | default: 10 }}, 
          name: 'BRONZE',
          unitBadge: {{ section.settings.tier_1_unit_badge | default: '18' | json }},
          unitText: {{ section.settings.tier_1_unit_text | default: '18,00' | json }},
          color: '{{ section.settings.tier_1_color | default: "#C15C30" }}',
          barBgImage: '{{ section.settings.tier_1_bar_image | image_url: width: 1000 }}',
          badgeBgImage: '{{ section.settings.tier_1_badge_bg_image | image_url: width: 400 }}',
          gift: "{{ section.settings.tier_1_gift_text | escape }}",
          giftImg: "{{ section.settings.tier_1_gift_image | image_url: width: 200 }}"
        },
        { 
          qty: {{ section.settings.tier_2_qty | default: 8 }}, 
          discount: {{ section.settings.tier_2_pct | default: 15 }}, 
          name: 'PRATA',
          unitBadge: {{ section.settings.tier_2_unit_badge | default: '17' | json }},
          unitText: {{ section.settings.tier_2_unit_text | default: '17,00' | json }},
          color: '{{ section.settings.tier_2_color | default: "#777371" }}',
          barBgImage: '{{ section.settings.tier_2_bar_image | image_url: width: 1000 }}',
          badgeBgImage: '{{ section.settings.tier_2_badge_bg_image | image_url: width: 400 }}',
          gift: "{{ section.settings.tier_2_gift_text | escape }}",
          giftImg: "{{ section.settings.tier_2_gift_image | image_url: width: 200 }}"
        },
        { 
          qty: {{ section.settings.tier_3_qty | default: 12 }}, 
          discount: {{ section.settings.tier_3_pct | default: 20 }}, 
          name: 'OURO',
          unitBadge: {{ section.settings.tier_3_unit_badge | default: '16' | json }},
          unitText: {{ section.settings.tier_3_unit_text | default: '16,00' | json }},
          color: '{{ section.settings.tier_3_color | default: "#E3B760" }}',
          barBgImage: '{{ section.settings.tier_3_bar_image | image_url: width: 1000 }}',
          badgeBgImage: '{{ section.settings.tier_3_badge_bg_image | image_url: width: 400 }}',
          gift: "{{ section.settings.tier_3_gift_text | escape }}",
          giftImg: "{{ section.settings.tier_3_gift_image | image_url: width: 200 }}"
        },
        { 
          qty: {{ section.settings.tier_4_qty | default: 15 }}, 
          discount: {{ section.settings.tier_4_pct | default: 25 }}, 
          name: 'DIAMANTE',
          unitBadge: {{ section.settings.tier_4_unit_badge | default: '14' | json }},
          unitText: {{ section.settings.tier_4_unit_text | default: '14,90' | json }},
          color: '{{ section.settings.tier_4_color | default: "#7BCA0C" }}',
          barBgImage: '{{ section.settings.tier_4_bar_image | image_url: width: 1000 }}',
          badgeBgImage: '{{ section.settings.tier_4_badge_bg_image | image_url: width: 1000 }}',
          gift: "{{ section.settings.tier_4_gift_text | escape }}",
          giftImg: "{{ section.settings.tier_4_gift_image | image_url: width: 200 }}"
        }
      ];

      const bulkUi = {
        displayMode: {{ section.settings.bulk_display_mode | default: 'unit_price' | json }}
      };

      function formatTierBadgeInner(tier) {
        if (!tier) return '';
        if (bulkUi.displayMode === 'percentage') {
          return '<span style="display:flex; transform: rotate(-8deg);"><strong>' + tier.discount + '</strong>%</span>';
        }
        return '<span style="display:flex; transform: rotate(-8deg);"><strong>R$ ' + tier.unitBadge + '</strong></span>';
      }

      function buildNextTierHtml(needed, nextTier) {
        const qtyLabel = needed + ' ' + (needed === 1 ? 'item' : 'itens');
        const prefix = needed === 1 ? 'Falta' : 'Faltam';
        if (bulkUi.displayMode === 'percentage') {
          const tierNum = tiers.indexOf(nextTier) + 1;
          return prefix + ' <strong class="next-level-qty-text">' + qtyLabel + '</strong> para desbloquear NÍVEL <span class="next-level-num">' + tierNum + '</span> <strong class="next-level-name">' + nextTier.name + '</strong>';
        }
        return prefix + ' <strong class="next-level-qty-text">' + qtyLabel + '</strong> para desbloquear Holy\'s por <strong>R$ ' + nextTier.unitText + '</strong> cada';
      }

      function applyTierBadgeEl(el, tier) {
        if (!el || !tier) return;
        el.classList.toggle('is-unit-price', bulkUi.displayMode === 'unit_price');
        if (tier.badgeBgImage) {
          el.style.backgroundImage = 'url(' + tier.badgeBgImage + ')';
          el.style.backgroundSize = tiers.indexOf(tier) === tiers.length - 1 ? 'initial' : '100% 100%';
        } else {
          el.style.backgroundColor = tier.color;
          el.style.backgroundImage = 'none';
        }
        el.style.color = (tier.name === 'DIAMANTE' || tier.name === 'SUPREMO') ? '#344F53' : '#fff';
        el.innerHTML = formatTierBadgeInner(tier);
      }

      const neutralColor = '{{ section.settings.tier_0_color | default: "#AFAA7A" }}';

      let productsCache = [];
      let cartSyncController = null;
      let lastSelectedHash = '';
      let campaignMode = null;
      let campaignStage = null;
      let campaignTarget = 0;
      let campaignEligibleQty = 0;
      let campaignModalTotal = 0;
      let campaignBaselineQty = {};
      let lastCartEligibleQty = 0;
      let completeBannerHome = null;

      const campaignNudgeEl = document.querySelector('[data-bulk-campaign-nudge]');
      const campaignAlertEl = document.querySelector('[data-bulk-campaign-alert]');
      const campaignCouponEl = document.querySelector('[data-bulk-campaign-coupon]');
      const campaignCouponSavingsEl = document.querySelector('[data-bulk-campaign-coupon-savings]');
      const campaignHeaderMsgEl = document.querySelector('[data-bulk-campaign-header-msg]');
      const campaignIncentiveEl = document.querySelector('[data-bulk-campaign-incentive]');
      const campaignInterceptPanelEl = document.querySelector('[data-bulk-campaign-intercept-panel]');
      const campaignCompleteBannerEl = document.querySelector('[data-bulk-campaign-complete-banner]');
      const campaignGridLabelEl = document.querySelector('[data-bulk-campaign-grid-label]');

      function getCampaignCfg() {
        return window.BulkCampaign && window.BulkCampaign.cfg ? window.BulkCampaign.cfg : null;
      }

      function campaignFill(str, map) {
        if (window.BulkCampaign && window.BulkCampaign.fill) return window.BulkCampaign.fill(str, map);
        let out = str || '';
        Object.keys(map || {}).forEach(k => {
          out = out.split('{{' + k + '}}').join(map[k]);
        });
        return out;
      }

      function getTierForQty(qty) {
        let tier = null;
        tiers.forEach(t => { if (qty >= t.qty) tier = t; });
        return tier;
      }

      function calcCampaignSavings(total, qty, target) {
        if (!qty || !total) return { economia: 0, economia_meta: 0 };
        const currentTier = getTierForQty(qty);
        const targetTier = getTierForQty(target);
        const currentPct = currentTier ? currentTier.discount : 0;
        const targetPct = targetTier ? targetTier.discount : 0;
        const economia = total * (currentPct / 100);
        const avgUnit = total / qty;
        const projectedTotal = avgUnit * target;
        const economiaTarget = projectedTotal * (targetPct / 100);
        const economia_meta = Math.max(0, economiaTarget - economia);
        return { economia, economia_meta };
      }

      function formatCampaignMoney(cents) {
        return Shopify.formatMoney(Math.round(cents), window.money_format);
      }

      function buildCampaignFillMap(q, faltam, total) {
        const savings = calcCampaignSavings(total, q, campaignTarget);
        const cfg = getCampaignCfg();
        return {
          faltam: faltam,
          economia: formatCampaignMoney(savings.economia),
          economia_meta: formatCampaignMoney(savings.economia_meta),
          pct_cupom: cfg && cfg.coupon ? cfg.coupon.pct : 10
        };
      }

      function snapshotCampaignBaseline(cart) {
        campaignBaselineQty = {};
        (cart && cart.items ? cart.items : []).forEach(function (i) {
          campaignBaselineQty[String(i.variant_id)] = i.quantity;
        });
      }

      function updateQtyHighlight(item, qty) {
        if (!item || !item.el) return;
        const baseline = campaignBaselineQty[item.id] || 0;
        if (campaignMode && campaignMode !== 'coupon' && campaignMode !== 'normal') {
          item.el.classList.remove('qty-active');
          item.el.classList.toggle('qty-incremented', qty > baseline);
          item.el.classList.toggle('qty-in-cart', qty > 0 && qty <= baseline);
        } else {
          item.el.classList.remove('qty-incremented', 'qty-in-cart');
          item.el.classList.toggle('qty-active', qty > 0);
        }
      }

      function setCampaignStage(stage) {
        campaignStage = stage;
        if (container) {
          container.classList.remove('is-campaign-intercept', 'is-campaign-complete-stage', 'is-campaign-offer2-intercept', 'is-campaign-offer1-intercept', 'is-campaign-offer1-complete', 'is-campaign-coupon', 'is-offer1-progress-preview', 'is-offer1-progress-complete');
          if (stage === 'intercept') {
            container.classList.add('is-campaign-intercept');
            if (campaignMode === 'offer2') container.classList.add('is-campaign-offer2-intercept');
            if (campaignMode === 'offer1') container.classList.add('is-campaign-offer1-intercept');
          }
          if (stage === 'complete') {
            container.classList.add('is-campaign-complete-stage');
            if (campaignMode === 'offer1') container.classList.add('is-campaign-offer1-complete');
            if (campaignMode === 'coupon') container.classList.add('is-campaign-coupon');
          }
        }
      }

      function getOffer1PromoTier() {
        const match = tiers.find(function (t) { return t.unitBadge === '16'; });
        return match || tiers[Math.max(0, tiers.length - 2)];
      }

      function getOffer1OuroTier() {
        return tiers[2] || getOffer1PromoTier();
      }

      function getOffer1DiamanteTier() {
        return tiers[tiers.length - 1] || getOffer1PromoTier();
      }

      function isOffer1PreviewContext(qty) {
        const cfg = getCampaignCfg();
        if (!cfg || !cfg.offer1 || campaignMode) return false;
        const q = qty != null ? qty : lastCartEligibleQty;
        if (cfg.offer1UnifiedHeader === false) return false;
        const target = cfg.offer1.target || 15;
        return q >= cfg.offer1.from && q < target;
      }

      function isOffer1NativeHeaderContext(qty) {
        const cfg = getCampaignCfg();
        if (!cfg || !cfg.offer1 || campaignMode) return false;
        const q = qty != null ? qty : lastCartEligibleQty;
        if (cfg.offer1UnifiedHeader === false) return false;
        return q >= cfg.offer1.from;
      }

      function getOffer1NativeHeaderVariant(qty) {
        const cfg = getCampaignCfg();
        const target = (cfg && cfg.offer1) ? (cfg.offer1.target || 15) : 15;
        return qty >= target ? 'complete' : 'preview';
      }

      function isOffer1ProgressContext(qty) {
        const cfg = getCampaignCfg();
        if (!cfg || !cfg.offer1) return false;
        const q = qty != null ? qty : (campaignMode === 'offer1' ? campaignEligibleQty : lastCartEligibleQty);
        const inCampaignOffer1 = campaignMode === 'offer1';
        const inComplete = campaignMode === 'offer1' && campaignStage === 'complete';
        const preview = isOffer1PreviewContext(q);
        const nativeHeader = isOffer1NativeHeaderContext(q);
        return inCampaignOffer1 || preview || nativeHeader || inComplete;
      }

      function applyOffer1BarFill(tier) {
        if (!progressFill || !tier) return;
        progressFill.style.backgroundImage = 'none';
        if (tier.barBgImage) {
          progressFill.style.backgroundImage = 'url(' + tier.barBgImage + ')';
          progressFill.style.backgroundSize = 'cover';
        } else {
          progressFill.style.backgroundColor = tier.color || '#E3B760';
        }
      }

      function applyOffer1CompleteBarFill() {
        if (!progressFill) return;
        const tier = getOffer1DiamanteTier();
        progressFill.style.backgroundImage = 'none';
        if (tier.barBgImage) {
          progressFill.style.backgroundImage = 'url(' + tier.barBgImage + ')';
          progressFill.style.backgroundSize = 'cover';
        } else {
          progressFill.style.backgroundColor = '#ff5017';
        }
      }

      function applyOffer1CompleteBadge(el) {
        if (!el) return;
        const tier = getOffer1DiamanteTier();
        el.classList.remove('is-lock-badge');
        el.classList.add('is-offer1-complete-badge');
        el.style.backgroundImage = 'none';
        el.style.backgroundColor = '#005234';
        el.style.color = '#fff';
        el.classList.toggle('is-unit-price', bulkUi.displayMode === 'unit_price');
        el.innerHTML = formatTierBadgeInner(tier);
      }

      function buildOffer1CompleteProgressText(faltam) {
        const tier = getOffer1DiamanteTier();
        const qtyLabel = faltam + ' ' + (faltam === 1 ? 'item' : 'itens');
        const prefix = faltam === 1 ? 'Falta' : 'Faltam';
        return prefix + ' <strong>' + qtyLabel + '</strong> para desbloquear Holy\'s por <strong>R$ ' + tier.unitText + '</strong> cada';
      }

      function renderOffer1ProgressHeader(opts) {
        const cfg = getCampaignCfg();
        if (!cfg) return;
        const variant = (opts && opts.variant) || 'preview';
        const target = cfg.offer1.target || 15;
        const q = opts && opts.q != null ? opts.q : campaignEligibleQty;
        const faltam = opts && opts.faltam != null ? opts.faltam : Math.max(0, target - q);
        const diamante = getOffer1DiamanteTier();

        if (container) {
          container.classList.toggle('is-offer1-progress-preview', variant === 'preview');
          container.classList.toggle('is-offer1-progress-complete', variant === 'complete' && !campaignMode);
        }
        if (savingsHeader) {
          savingsHeader.classList.remove('is-campaign-progress', 'is-campaign-complete', 'is-campaign-intercept', 'is-campaign-offer2-progress');
          savingsHeader.classList.toggle('is-campaign-offer1-progress', variant !== 'complete');
          savingsHeader.classList.toggle('is-campaign-offer1-complete-progress', variant === 'complete');
        }
        if (levelMaxMsg) levelMaxMsg.style.display = 'none';
        if (savingsContent) savingsContent.style.display = 'flex';
        if (savingsActiveMsg) savingsActiveMsg.style.display = 'flex';
        if (progressBar) progressBar.style.display = q > 0 ? 'block' : 'none';

        if (progressFill) {
          if (variant === 'complete') {
            const tierQty = diamante.qty || target;
            progressFill.style.width = (tierQty > 0 ? Math.min((q / tierQty) * 100, 100) : 0) + '%';
            applyOffer1CompleteBarFill();
          } else {
            progressFill.style.width = (target > 0 ? Math.min((q / target) * 100, 100) : 0) + '%';
            applyOffer1BarFill(getOffer1OuroTier());
          }
        }

        if (tierBadge) {
          tierBadge.style.display = 'flex';
          if (variant === 'complete') {
            applyOffer1CompleteBadge(tierBadge);
          } else {
            tierBadge.classList.remove('is-offer1-complete-badge');
            tierBadge.classList.remove('is-lock-badge');
            applyTierBadgeEl(tierBadge, getOffer1PromoTier());
          }
        }

        if (nextTierInfo) {
          if (variant === 'complete') {
            const faltamTier = Math.max(0, (diamante.qty || target) - q);
            if (faltamTier > 0) {
              nextTierInfo.style.display = 'block';
              nextTierInfo.innerHTML = buildOffer1CompleteProgressText(faltamTier);
            } else {
              nextTierInfo.style.display = 'none';
              nextTierInfo.innerHTML = '';
            }
          } else {
            nextTierInfo.style.display = 'block';
            nextTierInfo.innerHTML = buildOffer1ProgressText(faltam);
          }
        }
      }

      function buildOffer1CompleteTitle(template) {
        const raw = (template || 'PARABÉNS LIBEROU HOLYS POR R$16').trim();
        const highlight = 'HOLYS POR R$16';
        const idx = raw.indexOf(highlight);
        if (idx > -1) {
          return '<span class="bulk-campaign-header-msg__title--rest">' + raw.slice(0, idx) + '</span>' +
            '<strong class="bulk-campaign-header-msg__title--highlight">' + highlight + '</strong>';
        }
        return '<strong class="bulk-campaign-header-msg__title--lead">' + raw + '</strong>';
      }

      function buildOffer1SavingsBannerHtml(map) {
        return '<span class="bulk-campaign-complete-banner__prefix">Você economizou</span> ' +
          '<strong class="bulk-campaign-complete-banner__amount">' + map.economia + '</strong>';
      }

      function mountOffer1CompleteBanner() {
        if (!campaignCompleteBannerEl || !campaignInterceptPanelEl) return;
        if (!completeBannerHome) {
          completeBannerHome = campaignCompleteBannerEl.parentElement;
        }
        if (campaignCompleteBannerEl.parentElement !== campaignInterceptPanelEl) {
          campaignInterceptPanelEl.appendChild(campaignCompleteBannerEl);
        }
      }

      function restoreCompleteBannerHome() {
        if (!campaignCompleteBannerEl || !completeBannerHome) return;
        if (campaignCompleteBannerEl.parentElement !== completeBannerHome) {
          completeBannerHome.appendChild(campaignCompleteBannerEl);
        }
        campaignCompleteBannerEl.hidden = true;
        campaignCompleteBannerEl.innerHTML = '';
        campaignCompleteBannerEl.classList.remove('is-offer1-savings-box');
      }

      function buildOffer1ProgressText(faltam) {
        const tier = getOffer1PromoTier();
        const qtyLabel = faltam + ' ' + (faltam === 1 ? 'item' : 'itens');
        const prefix = faltam === 1 ? 'Falta' : 'Faltam';
        if (bulkUi.displayMode === 'percentage') {
          const tierNum = tiers.indexOf(tier) + 1;
          return prefix + ' <strong>' + qtyLabel + '</strong> para desbloquear NÍVEL <span class="next-level-num">' + tierNum + '</span> <strong class="next-level-name">' + tier.name + '</strong>';
        }
        return prefix + ' <strong>' + qtyLabel + '</strong> para desbloquear Holy\'s por <strong>R$ ' + tier.unitText + '</strong> cada';
      }

      function buildOffer1IncentiveHtml(faltam, map) {
        return '<span class="bulk-campaign-incentive__text">Falta só <strong class="bulk-campaign-incentive__qty">' + faltam + ' un</strong> para economizar <strong class="bulk-campaign-incentive__savings">' + map.economia_meta + '</strong></span>';
      }

      function applyOffer2LockBadge(el) {
        if (!el) return;
        el.classList.add('is-lock-badge');
        el.style.backgroundColor = '#005234';
        el.style.color = '#fff';
        el.innerHTML = '<span class="bulk-tier-badge-gem__lock" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 68 68"><g transform="translate(8.743 4.058)"><path d="M53.4,24.307H47.826V17.336A15.336,15.336,0,0,0,32.49,2H29.7A15.336,15.336,0,0,0,14.365,17.336v6.971H8.788A2.788,2.788,0,0,0,6,27.1V60.557a2.788,2.788,0,0,0,2.788,2.788H53.4a2.788,2.788,0,0,0,2.788-2.788V27.1A2.788,2.788,0,0,0,53.4,24.307ZM19.942,17.336A9.759,9.759,0,0,1,29.7,7.577H32.49a9.759,9.759,0,0,1,9.759,9.759v6.971H19.942ZM50.614,57.768H11.577V29.884H50.614Z" transform="translate(-6 -2)" fill="currentColor"/><path d="M31.054,31.463a5.577,5.577,0,1,0-8.365,4.88v3.486a2.788,2.788,0,0,0,5.577,0V36.342A5.577,5.577,0,0,0,31.054,31.463Z" transform="translate(-0.521 7.436)" fill="currentColor"/></g></svg></span>';
      }

      function buildOffer2ProgressText(faltam, cfg) {
        const qty = faltam + ' ' + (faltam === 1 ? 'item' : 'itens');
        const lock = (cfg && cfg.offer2LockLabel) ? cfg.offer2LockLabel : 'Cupom Secreto';
        return 'Falta <strong>' + qty + '</strong> para desbloquear <strong>' + lock + '</strong>';
      }

      function buildOffer2InterceptTitle(title) {
        const raw = (title || 'TEM CERTEZA QUE JÁ VAI FINALIZAR?').trim();
        const splitAt = raw.indexOf(' QUE ');
        if (splitAt > -1) {
          return '<strong class="bulk-campaign-header-msg__title--lead">' + raw.slice(0, splitAt) + '</strong>' +
            '<span class="bulk-campaign-header-msg__title--rest">' + raw.slice(splitAt) + '</span>';
        }
        return '<strong class="bulk-campaign-header-msg__title--lead">' + raw + '</strong>';
      }

      function buildOffer2IncentiveHtml(faltam, cfg) {
        const lock = (cfg && cfg.offer2LockLabel) ? cfg.offer2LockLabel : 'Cupom Secreto';
        return '<span class="bulk-campaign-incentive__text">Com <strong class="bulk-campaign-incentive__qty">+' + faltam + ' un</strong> você libera o <strong class="bulk-campaign-incentive__lock">' + lock + '</strong>.</span>';
      }

      function updateCampaignCta(faltam) {
        const cfg = getCampaignCfg();
        const btn = document.querySelector('.bulk-buy-btn');
        if (!btn) return;
        const txt = btn.querySelector('.bulk-btn-text');
        btn.classList.remove('is-cta-intercept', 'is-cta-complete', 'is-campaign-ready');
        if (campaignStage === 'intercept' && faltam > 0) {
          btn.classList.add('is-cta-intercept');
          if (txt && cfg && cfg.btnRefuse) txt.textContent = cfg.btnRefuse.toUpperCase();
        } else if (faltam <= 0 && campaignMode !== 'coupon') {
          btn.classList.add('is-cta-complete', 'is-campaign-ready');
          if (txt) {
            if (campaignMode === 'offer2' && cfg && cfg.btnCompleteOffer2) {
              txt.textContent = cfg.btnCompleteOffer2.toUpperCase();
            } else if (cfg && cfg.btnComplete) {
              txt.textContent = cfg.btnComplete.toUpperCase();
            } else {
              txt.textContent = 'COMPRAR COM DESCONTO';
            }
          }
        } else if (campaignMode === 'coupon') {
          btn.classList.add('is-campaign-ready');
          if (txt) txt.textContent = 'COMPRAR AGORA';
        } else if (txt) {
          txt.textContent = 'COMPRAR AGORA';
        }
      }

      function countUnlockedGifts(qty) {
        let n = 0;
        tiers.forEach(function (t) {
          if (t.gift && qty >= t.qty) n += 1;
        });
        return n;
      }

      function buildCouponTitleHtml(template) {
        const raw = (template || '').trim();
        const m = raw.match(/(\+\d+\s*%\s*OFF)/i);
        if (!m) {
          return '<strong class="bulk-campaign-header-msg__title--lead">' + raw + '</strong>';
        }
        const hi = m[1];
        const idx = raw.indexOf(hi);
        return '<span class="bulk-campaign-header-msg__title--rest">' + raw.slice(0, idx) + '</span>' +
          '<strong class="bulk-campaign-header-msg__title--highlight">' + hi + '</strong>' +
          '<span class="bulk-campaign-header-msg__title--rest">' + raw.slice(idx + hi.length) + '</span>';
      }

      function buildCouponSavingsHtml(economiaText, giftsCount) {
        const giftsLabel = giftsCount + ' ' + (giftsCount === 1 ? 'brinde' : 'brindes');
        return '<p class="bulk-campaign-coupon-savings__line">Usando o cupom você vai economizar <strong>' + economiaText + '</strong></p>' +
          '<p class="bulk-campaign-coupon-savings__line">E ainda tá levando pra casa <strong>' + giftsLabel + '</strong></p>';
      }

      function applyCampaignGridLayout() {
        const cfg = getCampaignCfg();
        const isFlat = campaignStage === 'intercept' || campaignStage === 'complete' || campaignMode === 'coupon';
        if (campaignGridLabelEl) {
          campaignGridLabelEl.hidden = !isFlat;
          if (isFlat && cfg) campaignGridLabelEl.textContent = cfg.gridLabel || 'HOLYS NO SEU CARRINHO';
        }
        productsCache.forEach(function (item) {
          const qty = parseInt(item.input ? item.input.value : 0, 10) || 0;
          if (isFlat) {
            item.el.style.display = qty > 0 ? '' : 'none';
          } else {
            item.el.style.display = '';
          }
          updateQtyHighlight(item, qty);
        });
      }

      function restoreNativeBulkUI() {
        campaignStage = null;
        campaignBaselineQty = {};
        if (container) {
          container.classList.remove('is-campaign-intercept', 'is-campaign-complete-stage', 'is-campaign-offer2-intercept', 'is-campaign-offer1-intercept', 'is-campaign-offer1-complete', 'is-campaign-coupon', 'is-offer1-progress-preview', 'is-offer1-progress-complete');
        }
        if (savingsHeader) {
          savingsHeader.classList.remove('is-campaign-progress', 'is-campaign-complete', 'is-campaign-intercept', 'is-campaign-offer2-progress', 'is-campaign-offer1-progress', 'is-campaign-offer1-complete-progress');
          savingsHeader.style.backgroundColor = '';
          savingsHeader.style.backgroundImage = '';
          savingsHeader.style.justifyContent = '';
        }
        if (campaignInterceptPanelEl) campaignInterceptPanelEl.hidden = true;
        if (campaignHeaderMsgEl) {
          campaignHeaderMsgEl.hidden = true;
          campaignHeaderMsgEl.textContent = '';
          campaignHeaderMsgEl.innerHTML = '';
        }
        if (campaignIncentiveEl) {
          campaignIncentiveEl.hidden = true;
          campaignIncentiveEl.textContent = '';
          campaignIncentiveEl.innerHTML = '';
          campaignIncentiveEl.classList.remove('bulk-campaign-incentive--outline');
        }
        if (campaignCouponEl) {
          campaignCouponEl.hidden = true;
          campaignCouponEl.classList.remove('is-visible');
        }
        if (campaignCouponSavingsEl) {
          campaignCouponSavingsEl.hidden = true;
